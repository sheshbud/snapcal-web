# Backend scan endpoint
# AWS events API (DynamoDB). Leave blank to use on-device storage only.
VITE_EVENTS_URL=
VITE_SCAN_URL=https://snapcal-backend.vercel.app/api/scan
# Backend Google Calendar endpoint
VITE_GCAL_URL=https://snapcal-backend.vercel.app/api/gcal
# Google OAuth client id (public). Enables "Add to Google Calendar".
VITE_GOOGLE_CLIENT_ID=
# Privacy policy link (defaults to bundled /privacy.html)
VITE_PRIVACY_URL=/privacy.html
# Optional: must match APP_SHARED_KEY on the backend if set there
# VITE_APP_KEY=
